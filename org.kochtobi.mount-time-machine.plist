<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.kochtobi.mount-time-machine</string>

    <key>ProgramArguments</key>
    <array>
        <!-- install.sh replaces this with the wrapper app it builds at
             ~/Applications/MountTimeMachine.app/Contents/MacOS/applet. The app
             gives the job an application identity, so macOS can ask for
             "Network Volumes" consent instead of silently denying the SMB
             share (TCC). With the no-app install option this stays the plain
             script and the job needs Full Disk Access instead.
             Manual installs keep this path and must grant Full Disk Access. -->
        <string>/usr/local/bin/mount-time-machine.sh</string>
    </array>

    <!--
        Replace REPLACE_WITH_* below. Optional settings (SMB_SHARE, IMAGE_NAME,
        LOG_FILE, IMAGE_KEYCHAIN_SERVICE, ...) can be added here as well; see
        README.md. TM_VOLUME is optional too: delete the key to let the script
        learn the volume name from the first successful attach.

        Note: the app wrapper (the default with install.sh) does NOT read these
        variables when it runs the mount script - AppleScript's `do shell
        script` uses a fixed environment, so the installer writes the settings
        to ~/.config/auto-mount-on-login/config.env instead. These keys are
        still read by the start-autobackup / stop-autobackup helpers, and by the
        script itself with the no-app install option, so keep them in sync.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>

        <key>TM_VOLUME</key>
        <string>REPLACE_WITH_TIME_MACHINE_VOLUME_NAME</string>

        <key>SMB_USER</key>
        <string>REPLACE_WITH_YOUR_USER_ID</string>

        <key>SMB_SERVER</key>
        <string>smb://workgroup-storage.qbic.uni-tuebingen.de</string>

        <key>SUBNET</key>
        <string>134.2.0.0/16</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>60</integer>
</dict>
</plist>
